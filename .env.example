# LLM provider — switch vendors without touching any code
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Or set LLM_PROVIDER=openai and fill these instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where the audit trail gets written
AUDIT_LOG_PATH=audit_log.jsonl

# Optional: turn on LangSmith tracing instead of eval_harness.py's local traces
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agentops-pr-copilot
